APP_NAME=Ravand
APP_ENV=local
APP_KEY=
# Keep disabled for security. Only enable temporarily on a local dev machine.
APP_DEBUG=false
APP_URL=http://localhost:8000

# --- Locale & region ---
# Dates are always stored as UTC/Gregorian in the database; Jalali display
# happens in the UI layer (ADR-005).
APP_TIMEZONE=UTC
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---
# Target engine: MySQL 8.4 LTS (ADR-007).
# Current dev environment: XAMPP / MariaDB. Adjust credentials to your setup.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ravand
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Owner bootstrap (optional, ADR-018) ---
# When set, `php artisan ravand:create-owner` runs without interactive
# prompts and uses these values. Local/CI convenience only: remove the
# password after the first boot and never commit real credentials.
# RAVAND_OWNER_NAME=Owner Name
# RAVAND_OWNER_EMAIL=owner@example.com
# RAVAND_OWNER_PASSWORD=change-me-long-and-random
# RAVAND_TENANT_NAME=My Store
# RAVAND_TENANT_SLUG=my-store
# RAVAND_TENANT_CURRENCY=IRT

VITE_APP_NAME="${APP_NAME}"
